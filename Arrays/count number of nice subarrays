class Solution {
public:
int atMost(vector<int>&nums,int k){
    int cnt=0,maxsize=0;
        int n=nums.size();
        int left=0;
        for(int right=0;right<n;right++){
            if(nums[right]%2!=0)maxsize++;
            while(maxsize>k){
                if(nums[left]%2!=0)maxsize--;
                left++;

            }
            cnt+=(right-left+1);
        }
        return cnt;
}
    int numberOfSubarrays(vector<int>& nums, int k) {
        return atMost(nums,k)-atMost(nums,k-1);
    }
};
