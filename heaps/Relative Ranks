class Solution {
public:
    vector<string> findRelativeRanks(vector<int>& scores) {
        int n=scores.size();
        vector<string>ans(n);
        priority_queue<pair<int,int>>pq;
        for(int i=0;i<scores.size();i++){
            pq.push({scores[i],i});
        }
        int rank=1;
        while(!pq.empty()){
            auto top=pq.top();
            pq.pop();
            int ind=top.second;
     if(rank==1)ans[ind]="Gold Medal";
  else if(rank==2 )ans[ind]="Silver Medal";
 else if(rank==3)ans[ind]="Bronze Medal";
 else ans[ind]=to_string(rank);
             rank++;
        }
        return ans;
    }
};
