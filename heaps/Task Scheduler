class Solution {
public:
    int leastInterval(vector<char>& tasks, int n) {
        unordered_map<char,int>mp;
        
        int maxfreq=0;
        for(char c:tasks)
        {
            mp[c]++;
            maxfreq=max(maxfreq,mp[c]);
        }
        int countmax=0;
        for(auto it:mp){
            if(it.second==maxfreq)
            countmax++;
        }
        int formula=(maxfreq-1)*(n+1)+countmax;
        return max((int)tasks.size(),formula);
        
    }
};
