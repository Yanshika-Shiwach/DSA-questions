class Solution {
public:
    string decodeString(string s) {
        stack<int>numst;
        stack<string>strst;
        string ans="";
        int num=0;
        for(char c:s){
            if(isdigit(c))
          num=num*10+(c-'0');
            else if(c=='['){
           numst.push(num);
           strst.push(ans);
           num=0;
           ans="";
            }
            else if(c==']')
            {
             int repeat=numst.top();
             numst.pop();
            string temp=ans;
            ans=strst.top();
            strst.pop();
            while(repeat--)
            ans+=temp;
            }
            else
            ans+=c;
        }
        return ans;
    }
};
