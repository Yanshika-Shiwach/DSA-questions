class Solution {
public:
    int evalRPN(vector<string>& tokens) {
        stack<int> st;
        int n = tokens.size();
        int i = 0;

        while(i < n){

            if(tokens[i]!="+" && tokens[i]!="-" && tokens[i]!="*" && tokens[i]!="/"){
                st.push(stoi(tokens[i]));
            }
            else{
                int b = st.top(); st.pop();
                int a = st.top(); st.pop();

                if(tokens[i]=="+") st.push(a+b);
                else if(tokens[i]=="-") st.push(a-b);
                else if(tokens[i]=="*") st.push(a*b);
                else st.push(a/b);
            }

            i++;
        }

        return st.top();
    }
};
