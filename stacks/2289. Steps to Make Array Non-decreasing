class Solution {
public:
    int totalSteps(vector<int>& nums) {
        stack<pair<int,int>>st;
        int ans=0;
        for(int num:nums){
            int steps=0;
            while(!st.empty()&&st.top().first<=num){
                steps=max(steps,st.top().second);
                st.pop();
            }
            if(st.empty())steps=0;
            else
            steps++;
            ans=max(steps,ans);
            st.push({num,steps});
        }
        return ans;
    }
};
