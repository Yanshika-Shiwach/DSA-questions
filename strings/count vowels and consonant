void checkString(string s) {
    int v = 0;
    int c = 0;

    // Your code here
    int n=s.size();
    for(int i=0;i<n;i++){
          if(s[i] == ' ') continue;
        if(s[i]=='a'||s[i]=='e'||s[i]=='i'||s[i]=='o'||s[i]=='u')
        v++;
        else c++;
    }
    

    if (v > c)
        cout << "Yes";
    else if (c > v)
        cout << "No";
    else
        cout << "Same";

    cout << endl;
}
