class Solution {
public:
    int longestPalindrome(string s) {
        unordered_map<char,int>mp;
        int cnt=0;
        for(char c:s){
            mp[c]++;
        }
        bool odd=false;
        for(auto &it:mp){
            if(it.second%2==0){
                cnt+=it.second;
            }
            else{
                cnt+=it.second-1;
                odd=true;
            }
        }
        if(odd)cnt++;
return cnt;
    }
};
