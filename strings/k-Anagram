
class Solution {
  public:
    bool areKAnagrams(string &s1, string &s2, int k) {
        // code here
        int n=s1.size(),m=s2.size();
        if(n!=m)return false;
      vector<char>freq(26,0);
      for(char c:s1)
      freq[c-'a']++;
      for(char c:s2)
      freq[c-'a']--;
      int changes=0;
      for(int i=0;i<26;i++){
          if(freq[i]>0){
              changes+=freq[i];
          }
      }
      return changes<=k;
    }
};
