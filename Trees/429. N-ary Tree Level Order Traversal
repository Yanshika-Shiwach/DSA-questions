class Solution {
public:
    vector<vector<int>> levelOrder(Node* root) {
        queue<Node*>q;
        vector<vector<int>>ans;
        if(root==NULL)return ans;
        q.push(root);
        while(!q.empty()){
            int size=q.size();
            vector<int>level;
            for(int i=0;i<size;i++){
                Node*node=q.front();
                q.pop();
                level.push_back(node->val);
                for(auto child:node->children){
                    q.push(child);
                }
            }
            ans.push_back(level);
        }
        return ans;
    }
};
