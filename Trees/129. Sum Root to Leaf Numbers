class Solution {
public:
int sum(TreeNode*root,int curr){
    if(root==NULL)return 0;
    curr=curr*10+root->val;
    if(root->left==NULL&&root->right==NULL)return curr;
    return sum(root->left,curr)+sum(root->right,curr);

}
    int sumNumbers(TreeNode* root) {
        return sum(root,0);
    }
};
